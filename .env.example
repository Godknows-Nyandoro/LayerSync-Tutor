# Copy this file to .env and fill in the real values.
# .env is ignored by git: never commit it.

# Neon Postgres (Neon dashboard -> Connect)
# connect_timeout=15 gives Neon time to wake up from sleep (the free tier sleeps when idle).
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# OpenRouter (used from step 5)
OPENROUTER_API_KEY="sk-or-..."
OPENROUTER_MODEL="google/gemini-3.1-flash-lite"

# Secret used to sign login cookies (any long random string, used from step 3)
SESSION_SECRET="change-me-to-a-long-random-string"
