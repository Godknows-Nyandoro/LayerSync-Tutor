// Prisma schema: describes our database tables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")          // pooled connection, used by the app
  directUrl = env("DATABASE_URL_UNPOOLED") // direct connection, used for migrations
}

enum Role {
  STUDENT
  TEACHER
}

// A person who can log in: a student or a teacher.
model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String // bcrypt hash, never the real password
  role         Role
  studentCode  String?   @unique // e.g. "SA-001" (students only)
  className    String // e.g. "4C"
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
}

// One row per syllabus learning objective, e.g. "1.1.4".
model Objective {
  id          String   @id // syllabus ID, e.g. "1.1.4"
  paper       Int // 1 or 2
  topicNumber Int // 1 to 10
  topic       String // e.g. "Data representation"
  subtopicId  String // e.g. "1.1"
  subtopic    String // e.g. "Number systems"
  statement   String // "Candidates should be able to..."
  notes       String[] // "Notes and guidance"
  sortOrder   Int // keeps syllabus order ("10.1" would otherwise sort before "2.1.1")
}
