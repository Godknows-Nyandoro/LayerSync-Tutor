// Prisma schema: describes our database tables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")          // pooled connection, used by the app
  directUrl = env("DATABASE_URL_UNPOOLED") // direct connection, used for migrations
}

enum Role {
  STUDENT
  TEACHER
}

enum QuestionType {
  MCQ // multiple choice, marked by code
  SHORT // short answer, marked by AI against the mark scheme
}

enum GuideStatus {
  DRAFT // only the teacher can see it
  APPROVED // students can see it
}

enum MasteryStatus {
  NOT_STARTED
  LEARNING
  MASTERED
}

enum FlagReason {
  WRONG // the tutor said something incorrect
  CONFUSING // the explanation did not make sense
  GAVE_ANSWER // the tutor gave away the answer
  OTHER
}

enum FlagStatus {
  OPEN // the teacher has not looked at it yet
  RESOLVED
}

// A person who can log in: a student or a teacher.
model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String // bcrypt hash, never the real password
  role         Role
  studentCode  String?   @unique // e.g. "SA-001" (students only)
  className    String // e.g. "4C"
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())

  attempts      Attempt[]
  mastery       Mastery[]
  tutorSessions TutorSession[]
  flags         TutorFlag[]
}

// One row per syllabus learning objective, e.g. "1.1.4".
model Objective {
  id          String   @id // syllabus ID, e.g. "1.1.4"
  paper       Int // 1 or 2
  topicNumber Int // 1 to 10
  topic       String // e.g. "Data representation"
  subtopicId  String // e.g. "1.1"
  subtopic    String // e.g. "Number systems"
  statement   String // "Candidates should be able to..."
  notes       String[] // "Notes and guidance"
  sortOrder   Int // keeps syllabus order ("10.1" would otherwise sort before "2.1.1")

  questions Question[]
  mastery   Mastery[]
}

// A check / exam-style question, tied to one objective.
model Question {
  id          String       @id // e.g. "1.1-3"
  objectiveId String
  objective   Objective    @relation(fields: [objectiveId], references: [id])
  type        QuestionType
  prompt      String
  options     String[] // MCQ choices (empty for SHORT)
  answer      String // MCQ: the correct option. SHORT: a model answer
  markScheme  String[] // one line per mark point
  marks       Int
  sortOrder   Int

  attempts Attempt[]
}

// One learning guide per built topic ("1.1" or "10").
model Guide {
  id         String      @id @default(cuid())
  topicKey   String      @unique // "1.1" or "10"
  title      String
  sections   Json // list of { kind, heading, body, objectiveIds, diagram?, answer? }
  status     GuideStatus @default(DRAFT)
  approvedAt DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

// A student's answer to one question, with the marks and feedback they got.
model Attempt {
  id         String   @id @default(cuid())
  studentId  String
  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer     String
  score      Int
  maxScore   Int
  feedback   String
  createdAt  DateTime @default(now())
}

// A student's current status on one objective. Recalculated after every check.
model Mastery {
  studentId   String
  student     User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  objectiveId String
  objective   Objective     @relation(fields: [objectiveId], references: [id])
  status      MasteryStatus
  percent     Int // 0-100, from the latest attempt at each question
  updatedAt   DateTime      @updatedAt

  @@id([studentId, objectiveId])
}

// One chat with the AI tutor about one topic.
model TutorSession {
  id           String   @id @default(cuid())
  studentId    String
  student      User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topicKey     String // "1.1" or "10"
  messages     Json // list of { role: "user" | "assistant", content }
  inputTokens  Int      @default(0) // for cost estimates
  outputTokens Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  flags TutorFlag[]
}

// A student flagged one tutor reply as wrong, confusing, etc. The teacher reviews it.
model TutorFlag {
  id           String       @id @default(cuid())
  studentId    String
  student      User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sessionId    String
  session      TutorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  messageIndex Int // position of the flagged reply in the chat's messages list
  reason       FlagReason
  comment      String       @default("")
  status       FlagStatus   @default(OPEN)
  createdAt    DateTime     @default(now())
  resolvedAt   DateTime?

  @@unique([sessionId, messageIndex]) // one flag per reply
}
